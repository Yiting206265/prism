# Copy this file to .env.local and fill in your keys
GROQ_API_KEY=your_groq_api_key_here

# Cloudflare Workers AI — https://dash.cloudflare.com/profile/api-tokens
CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here

# Daily caps so public traffic stays in Cloudflare/Groq free pools (UTC day).
# Set a value to 0 to turn that feature off.
LISTEN_MAX_PER_DAY=30
LISTEN_MAX_PER_IP_PER_DAY=5
CF_COVER_MAX_PER_DAY=80
GROQ_MAX_PER_DAY=80
